<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>Adds a basic support to a Microsoft Testing Platform framework. Reference a framework-specific package to get the most from Allure.</Description>
        <PackageTags>$(PackageTags) mtp testingplatform microsofttestingplatform</PackageTags>
        <PackageIcon>Allure-Color.png</PackageIcon>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform" Version="2.2.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Allure.Net.Commons\Allure.Net.Commons.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../img/Allure-Color.png" Pack="true" PackagePath="/" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="msbuild/Allure.TestingPlatform.props" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

</Project>
