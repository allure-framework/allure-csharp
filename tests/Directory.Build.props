<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
            Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <Allure_TestingPlatform Condition=" '$(Allure_TestingPlatform)' == '' ">VsTest</Allure_TestingPlatform>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Don't compile samples as part of test projects. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);@(AllureSample)</DefaultItemExcludes>

        <!-- Mark all projects under ./tests/ as test projects. The only exception is Allure.Testing,
         which explicitly opts out. -->
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The full path of the directory containing locally built NuGet packages. -->
        <Allure_LocalNugetRepository Condition=" '$(Allure_LocalNugetRepository)' == '' ">$(
            [MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'package', 'release')
        )</Allure_LocalNugetRepository>

        <!-- A path to the NuGet cache directory.
         Using a local package cache avoids polluting the system cache with locally built packages. -->
        <Allure_PackageCacheDirectory Condition=" '$(Allure_PackageCacheDirectory)' == '' ">$(
            [MSBuild]::NormalizeDirectory(
                '$(MSBuildThisFileDirectory)',
                '..',
                'packages'
            )
        )</Allure_PackageCacheDirectory>

        <!-- The full list of frameworks the samples can be compiled and run against. -->
        <Allure_SampleSupportedTargetFrameworks
            Condition=" '$(Allure_SampleSupportedTargetFrameworks)' == '' ">$(TargetFramework)</Allure_SampleSupportedTargetFrameworks>

        <!-- The name of the test sample solution.
         It also serves as the prefix for the sample project names in that solution. -->
        <Allure_SampleSolutionName
            Condition=" '$(Allure_SampleSolutionName)' == '' ">$(MSBuildProjectName).Samples</Allure_SampleSolutionName>

        <!-- The directory where the sample solution is created. -->
        <Allure_SampleSolutionDir Condition=" '$(Allure_SampleSolutionDir)' == '' ">$(
            [MSBuild]::NormalizeDirectory(
                '$(ArtifactsPath)',
                'samples',
                '$(MSBuildProjectName)'
            )
        )</Allure_SampleSolutionDir>

        <!-- If set to true, the sample solution will be built immediately after it is generated.
         This improves performance of the subsequent test runs as MSBuild won't build the
         sample projects again unless changes are detected. -->
        <Allure_PreBuildTestSamples
            Condition=" '$(Allure_PreBuildTestSamples)' == '' ">false</Allure_PreBuildTestSamples>

        <!-- If set to true, the sample solution will be tested right after it's generated
         and built. This property simplifies using the pre-run flow for development. -->
        <Allure_PreRunTestSamples
            Condition=" '$(Allure_PreRunTestSamples)' == '' ">false</Allure_PreRunTestSamples>

        <!-- The target framework against which to run the sample projects.
         Must be one of the frameworks listed by Allure_SampleSupportedTargetFrameworks. -->
        <Allure_SampleSelectedTargetFramework
            Condition=" '$(Allure_SampleSelectedTargetFramework)' == '' ">$(TargetFramework)</Allure_SampleSelectedTargetFramework>

        <!-- The configuration used to compile the sample projects.
         For the default value, see ./tests/Directory.Build.targets -->
        <Allure_SampleConfiguration
            Condition=" '$(Allure_SampleConfiguration)' == '' "></Allure_SampleConfiguration>

        <!-- If set to true, integration tests do not invoke the sample projects.
         Instead, they assert against results that were already generated in the default results directory.
         This assumes that the Allure_RunTestSamples target has been run before the tests. -->
        <Allure_PreRunTestingFlow
            Condition=" '$(Allure_PreRunTestingFlow)' == '' ">$(Allure_PreRunTestSamples)</Allure_PreRunTestingFlow>

        <!-- The version of the projects under test. If set, all ProjectUnderTest items are converted into
         PackageReference items in the sample projects. Otherwise, they are converted to
         ProjectReference items. -->
        <Allure_TestTargetVersion
            Condition=" '$(Allure_TestTargetVersion)' == '' "></Allure_TestTargetVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The list of Allure properties used by the sample runner. -->
        <Allure_CompilerVisibleProperties>
            Allure_TestingPlatform;
            Allure_PreRunTestingFlow;
            Allure_SampleConfiguration;
            Allure_SampleSolutionDir;
            Allure_SampleSolutionName;
            Allure_SampleSelectedTargetFramework;
        </Allure_CompilerVisibleProperties>

        <!-- Put Allure properties on a single line and replace the separator with ':'.
         Otherwise, the value won't be picked up by *.GeneratedMSBuildEditorConfig.editorconfig,
         which is an INI file. Roslyn will then make the properties accessible to source generators.
         AllureMsbuildPropsGenerator will pass them to the compilation making them consumable by
         the sample runner. -->
        <Allure_PropertyNames>$(
            Allure_CompilerVisibleProperties
                .Replace('%0D', '')
                .Replace('%0A', '')
                .Replace(' ', '')
                .Replace(';', ':')
        )</Allure_PropertyNames>

    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="Allure_PropertyNames" />
        <CompilerVisibleProperty Include="$(Allure_CompilerVisibleProperties)" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Allure_SampleName" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Allure_RegistryNamespace" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Allure_ProjectFilePath" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Allure_ProjectRelativePath" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Allure_ResultsDirectory" />
    </ItemGroup>

    <ItemGroup>
        <!-- We're only including .cs samples by default. Other files need to be included on a
         per-project basis.
        Each AllureSample becomes an item in the generated sample project. The item includes
         the original sample file. You can control the item type by applying ItemType="...".
         Use Properties="..." to provide extra MSBuild properties to the generated project.
         Use ItemMetadata="..." to provide metadata to the item created for this sample. -->
        <AllureSample Include="**/Samples/**/*.cs" Exclude="**/.*" ItemType="Compile" />
    </ItemGroup>

</Project>