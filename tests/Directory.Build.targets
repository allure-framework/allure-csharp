<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))"
            Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

    <UsingTask TaskName="Allure.Build.Tasks.GenerateSampleSolution" AssemblyFile="$([MSBuild]::NormalizePath($(TargetDir), 'Allure.Build.Tasks.dll'))"/>

    <PropertyGroup>
        <!-- Test against the same framework as the testing project by default -->
        <Allure_SampleSupportedTargetFrameworks Condition=" '$(Allure_SampleSupportedTargetFrameworks)' == '' ">$(TargetFramework)</Allure_SampleSupportedTargetFrameworks>
        <Allure_SampleSelectedTargetFramework Condition=" '$(Allure_SampleSelectedTargetFramework)' == '' ">$(TargetFramework)</Allure_SampleSelectedTargetFramework>

        <Allure_SampleSolutionName Condition=" '$(Allure_SampleSolutionName)' == '' ">$(ProjectName).Samples</Allure_SampleSolutionName>
        <Allure_SampleSolutionDir Condition=" '$(Allure_SampleSolutionDir)' == '' ">$([MSBuild]::NormalizeDirectory($(ArtifactsPath), 'samples', '$(ProjectName)'))</Allure_SampleSolutionDir>
        <Allure_LocalNugetRepository Condition=" '$(Allure_LocalNugetRepository)' == '' ">$([MSBuild]::NormalizeDirectory($(ArtifactsPath), 'package', 'release'))</Allure_LocalNugetRepository>

        <Allure_PreBuildSamples Condition=" '$(Allure_PreBuildSamples)' == '' ">false</Allure_PreBuildSamples>
    </PropertyGroup>

    <Target Name="Allure_GenerateSamples"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition=" '@(AllureSample)' != '' ">

        <Allure.Build.Tasks.GenerateSampleSolution
            SampleSources="@(AllureSample)"
            SamplePackageReferences="@(SamplePackageReference)"
            SampleProjectReferences="@(SampleProjectReference)"
            SampleSolutionDir="$(Allure_SampleSolutionDir)"
            SampleSolutionName="$(Allure_SampleSolutionName)"
            SampleTargetFrameworks="$(Allure_SampleSupportedTargetFrameworks)"
            ArtifactsPath="$(ArtifactsPath)"
            LocalNugetRepository="$(Allure_LocalNugetRepository)">
            <Output TaskParameter="SampleSolutionPath" PropertyName="Allure_SampleSolutionPath" />
        </Allure.Build.Tasks.GenerateSampleSolution>

        <MSBuild
            Projects="$(Allure_SampleSolutionPath)"
            Targets="Build"
            BuildInParallel="$(BuildInParallel)"
            Condition=" '$(Allure_PreBuildSamples)' == 'true' "
            ContinueOnError="False" />
    </Target>
</Project>