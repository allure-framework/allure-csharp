<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))"
            Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <_Allure_RepoRoot>$(
            [MSBuild]::NormalizePath(
                '$(MSBuildThisFileDirectory)',
                '..',
            )
        )</_Allure_RepoRoot>
        <_Allure_BuildTaskPath>$(
            [MSBuild]::NormalizePath(
                '$(ArtifactsPath)',
                'bin',
                'Allure.Build.Tasks',
                'release',
                'Allure.Build.Tasks.dll'
            )
        )</_Allure_BuildTaskPath>
        <_Allure_BinDirectory>$(
            [MSBuild]::NormalizePath(
                '$(ArtifactsPath)',
                'bin'
            )
        )</_Allure_BinDirectory>
        <_Allure_ObjDirectory>$(
            [MSBuild]::NormalizePath(
                '$(ArtifactsPath)',
                'obj'
            )
        )</_Allure_ObjDirectory>
    </PropertyGroup>

    <UsingTask
        TaskName="Allure.Build.Tasks.GenerateSampleSolution"
        AssemblyFile="$(_Allure_BuildTaskPath)"/>

    <UsingTask
        TaskName="Allure.Build.Tasks.FillSampleMetadata"
        AssemblyFile="$(_Allure_BuildTaskPath)"/>

    <PropertyGroup>

        <!-- The Configuration property is unset in Directory.Build.props.
         Setting the default values of dependent properties here. -->
        <Allure_SampleConfiguration
            Condition=" '$(Allure_SampleConfiguration)' == '' ">$(Configuration)</Allure_SampleConfiguration>

        <_Allure_SampleSolutionPath>$(
            [MSBuild]::NormalizePath(
                '$(Allure_SampleSolutionDir)',
                '$(Allure_SampleSolutionName).slnx'
            )
        )</_Allure_SampleSolutionPath>

    </PropertyGroup>

    <PropertyGroup Condition=" '$(Allure_PreRunTestingFlow)' == 'true' ">
        <DefineConstants>$(DefineConstants);ALLURE_TEST_PRERUN_FLOW</DefineConstants>
    </PropertyGroup>

    <Target Name="_Allure_CompileBuildTasks">

        <PropertyGroup>
            <_Allure_BuildTasksProject>$(
                [MSBuild]::NormalizePath(
                    '$(_Allure_RepoRoot)',
                    'build',
                    'Allure.Build.Tasks',
                    'Allure.Build.Tasks.csproj'
                )
            )</_Allure_BuildTasksProject>
        </PropertyGroup>

        <MSBuild
            Projects="$(_Allure_BuildTasksProject)"
            Targets="Restore;Build"
            BuildInParallel="$(BuildInParallel)"
            Properties="Configuration=Release" />

    </Target>

    <Target
        Name="_Allure_ResolveTestSamples"
        Condition=" '@(AllureSample)' != '' "
        DependsOnTargets="_Allure_CompileBuildTasks">

        <Allure.Build.Tasks.FillSampleMetadata
            Samples="@(AllureSample)"
            RootDirectory="$(_Allure_RepoRoot)"
            ProjectDirectory="$(MSBuildProjectDirectory)"
            SampleSolutionDirectory="$(Allure_SampleSolutionDir)"
            SampleSolutionName="$(Allure_SampleSolutionName)"
            RootNamespace="$(RootNamespace)"
            BinDirectory="$(_Allure_BinDirectory)"
            ObjDirectory="$(_Allure_ObjDirectory)"
            Configuration="$(Allure_SampleConfiguration)"
            TargetFramework="$(Allure_SampleSelectedTargetFramework)">

            <Output TaskParameter="ResolvedSamples" ItemName="_Allure_ResolvedSample" />

        </Allure.Build.Tasks.FillSampleMetadata>

    </Target>

    <Target Name="_Allure_InjectSamplesToSourceGenerator"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun"
            Condition=" '@(AllureSample)' != '' "
            DependsOnTargets="_Allure_ResolveTestSamples">

        <!-- At this point, all AllureSample items must be already defined.
         We resolve the required proeprties (via FillSampleMetadata) and convert
         them to AdditionalFiles items to make them visible to the source generators. -->
        <ItemGroup>

            <AdditionalFiles
                Include="@(_Allure_ResolvedSample)"
                Allure_SampleName="%(_Allure_ResolvedSample.SampleName)"
                Allure_RegistryNamespace="%(_Allure_ResolvedSample.RegistryNamespace)"
                Allure_ProjectFilePath="%(_Allure_ResolvedSample.ProjectFilePath)"
                Allure_ProjectRelativePath="%(_Allure_ResolvedSample.ProjectRelativePath)"
                Allure_ResultsDirectory="%(_Allure_ResolvedSample.ResultsDirectory)" />

        </ItemGroup>

    </Target>

    <!-- This should go before _GenerateCompileDependencyCache.
     Otherwise, changes in DefineConstants won't be detected by CoreCompile.
     See https://github.com/dotnet/msbuild/pull/3978. -->
    <Target Name="_Allure_ResolveTestTarget"
            BeforeTargets="ResolveAssemblyReferences"
            Condition=" '@(AllureSample)' != '' ">

        <PropertyGroup Condition=" '$(Allure_TestTargetVersion)' == 'SNAPSHOT' ">
            <Allure_TestTargetVersion>$(Version)</Allure_TestTargetVersion>
        </PropertyGroup>

        <ItemGroup Condition=" '$(Allure_TestTargetVersion)' == '' ">
            <SampleProjectReference Include="@(ProjectUnderTest)" />
        </ItemGroup>

        <Exec
            Condition=" '$(Allure_TestTargetVersion)' != '' "
            Command="dotnet msbuild -getProperty:PackageId '%(ProjectUnderTest.Identity)'"
            ConsoleToMsBuild="true"
            StandardOutputImportance="low">

            <Output TaskParameter="ConsoleOutput" ItemName="_Allure_PackageUnderTest" />

        </Exec>

        <ItemGroup Condition=" '$(Allure_TestTargetVersion)' != '' ">
            <SamplePackageReference
                Include="@(_Allure_PackageUnderTest)"
                Version="$(Allure_TestTargetVersion)" />
        </ItemGroup>

        <!-- Enable parallel test execution:
          1. In pre-run flow: no conflicting dotnet test runs at all.
          2. If no projects are referenced (only NuGet packages): dotnet test doesn't build shared dependencies.
          NOTE: don't forget to alter this condition if sample-specific project references becomes supported.  -->
        <PropertyGroup Condition=" '$(Allure_PreRunTestingFlow)' == 'true' or '@(SampleProjectReference)' == '' ">
            <DefineConstants>$(DefineConstants);ALLURE_TEST_PARALLEL</DefineConstants>
        </PropertyGroup>

    </Target>

    <Target Name="Allure_GenerateTestSamples"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition=" '@(AllureSample)' != '' "
            DependsOnTargets="_Allure_CompileBuildTasks;_Allure_ResolveTestSamples">

        <MakeDir Directories="$(Allure_LocalNugetRepository)" />

        <Allure.Build.Tasks.GenerateSampleSolution
            SampleSources="@(_Allure_ResolvedSample)"
            SamplePackageReferences="@(SamplePackageReference)"
            SampleProjectReferences="@(SampleProjectReference)"
            ProjectDirectory="$(MSBuildProjectDirectory)"
            RootNamespace="$(RootNamespace)"
            SampleSolutionDir="$(Allure_SampleSolutionDir)"
            SampleSolutionName="$(Allure_SampleSolutionName)"
            SampleSolutionPath="$(_Allure_SampleSolutionPath)"
            SampleTargetFrameworks="$(Allure_SampleSupportedTargetFrameworks)"
            LocalNugetRepository="$(Allure_LocalNugetRepository)"
            PackageCacheDirectory="$(Allure_PackageCacheDirectory)"
        />

        <CallTarget
            Targets="Allure_BuildTestSamples"
            Condition=" '$(Allure_PreBuildTestSamples)' == 'true' or '$(Allure_PreRunTestSamples)' == 'true' " />

        <CallTarget
            Targets="Allure_RunTestSamples"
            Condition=" '$(Allure_PreRunTestSamples)' == 'true' "/>

    </Target>

    <Target Name="Allure_BuildTestSamples"
            Condition=" '@(AllureSample)' != '' ">

        <MSBuild
            Projects="$(_Allure_SampleSolutionPath)"
            Targets="Restore;Build"
            BuildInParallel="$(BuildInParallel)"
            Properties="Configuration=$(Allure_SampleConfiguration)"
            RemoveProperties="Platform" />

    </Target>

    <Target Name="Allure_RunTestSamples"
            Condition=" '@(AllureSample)' != '' "
            DependsOnTargets="_Allure_ResolveTestSamples">

        <Error Text="The sample solution $(_Allure_SampleSolutionPath) doesn't exist. Build $(MSBuildProjectName) to generate it"
            Condition=" !Exists('$(_Allure_SampleSolutionPath)') " />

        <ItemGroup>
            <_Allure_SampleResultDirectory
                Include="@(_Allure_ResolvedSample -> '%(ResultsDirectory)')"/>
        </ItemGroup>

        <RemoveDuplicates Inputs="@(_Allure_SampleResultDirectory)">
            <Output TaskParameter="Filtered" ItemName="_Allure_FilteredSampleResultDirectory" />
        </RemoveDuplicates>

        <RemoveDir Directories="@(_Allure_FilteredSampleResultDirectory)" />

        <MSBuild
            Projects="$(_Allure_SampleSolutionPath)"
            Targets="Allure_RunTestSamples"
            BuildInParallel="$(BuildInParallel)"
            Properties="
                Allure_TestSampleTarget=VSTest;
                Configuration=$(Allure_SampleConfiguration);
                Allure_BuildInParallel=$(BuildInParallel);
            "
            RemoveProperties="Platform"
            ContinueOnError="true" />

    </Target>

    <Target Name="Allure_CleanTestSamples"
            BeforeTargets="CoreClean"
            Condition="Exists('$(_Allure_SampleSolutionPath)')">

        <MSBuild
            Projects="$(_Allure_SampleSolutionPath)"
            Targets="Clean"
            BuildInParallel="$(BuildInParallel)"
            Properties="Configuration=$(Allure_SampleConfiguration)"
            RemoveProperties="Platform"
            ContinueOnError="True" />

    </Target>

    <Target Name="Allure_DeleteTestSamples"
            Condition=" '@(AllureSample)' != '' "
            DependsOnTargets="_Allure_ResolveTestSamples">

        <ItemGroup>
            <_Allure_SampleProjectOutputDirectory
                Include="@(_Allure_ResolvedSample -> '%(ProjectBinPath)')"/>
            <_Allure_SampleProjectOutputDirectory
                Include="@(_Allure_ResolvedSample -> '%(ProjectObjPath)')"/>
        </ItemGroup>

        <RemoveDuplicates Inputs="@(_Allure_SampleProjectOutputDirectory)">
            <Output TaskParameter="Filtered" ItemName="_Allure_FilteredSampleProjectOutputDirectory" />
        </RemoveDuplicates>

        <RemoveDir Directories="@(_Allure_FilteredSampleProjectOutputDirectory)" />
        <RemoveDir Directories="$(Allure_SampleSolutionDir)" />
    </Target>

</Project>